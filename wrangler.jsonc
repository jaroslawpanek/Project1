{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flashgen",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Keep the workers.dev URL for the MVP, but don't expose per-version Preview URLs
  // (they would serve the Worker with the same secrets).
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
}
